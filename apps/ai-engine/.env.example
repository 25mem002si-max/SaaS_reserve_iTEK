# ============================================
# LLM Configuration
# ============================================
LLM_PROVIDER=openai  # openai | anthropic
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
USE_LLM=false
LLM_FALLBACK_ENABLED=true
LLM_MAX_CALLS_PER_CONVERSATION=3
# ANTHROPIC_API_KEY=sk-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ============================================
# Backend API (Dev2)
# ============================================
BACKEND_ENABLED=false
BACKEND_API_URL=http://localhost:8000
BACKEND_API_KEY=your_backend_api_key
BACKEND_TIMEOUT_SECONDS=30
BACKEND_RETRY_COUNT=3

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=3600
REDIS_MAX_CONNECTIONS=10

# ============================================
# WhatsApp Meta
# ============================================
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EA...
WHATSAPP_API_VERSION=v18.0

# ============================================
# Application
# ============================================
APP_NAME="AI Engine - Réservations de restaurants"
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_FORMAT=text  # text | json
ENVIRONMENT=development
DEBUG=true

# ============================================
# Agent Configuration
# ============================================
MAX_ITERATIONS=10
HANDOFF_THRESHOLD=3
LOCK_DURATION_SECONDS=300
MIN_GUESTS_FOR_DEPOSIT=4
DEFAULT_CURRENCY=USD

# ============================================
# Guardrails
# ============================================
ENABLE_GUARDRAILS=true
ENABLE_FUNCTION_CALLING_VALIDATION=true
MAX_CONFIRMATION_ATTEMPTS=3