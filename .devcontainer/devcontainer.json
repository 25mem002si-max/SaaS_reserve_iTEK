{
  "name": "SaaS Multi-Agent IA",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/SaaS_reserve_iTEK",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },

  "postCreateCommand": "python -m venv apps/api-core/.venv && apps/api-core/.venv/bin/pip install -r apps/api-core/requirements.txt && python -m venv apps/ai-engine/.venv && apps/ai-engine/.venv/bin/pip install -r apps/ai-engine/requirements.txt",

  "customizations": {
    "vscode": {
      "extensions": [
        // Frontend & Next.js
        "dsznajder.es7-react-js-snippets",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "figma.figma-vscode-extension",

        // Backend Python (FastAPI, LangChain)
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",

        // Base de données & infra
        "cweijan.vscode-postgresql-client2",
        "ms-azuretools.vscode-docker",
        "ms-vsliveshare.vsliveshare"
      ]
    }
  },

  "forwardPorts": [3000, 8000, 8001, 5432, 6379],
  "portsAttributes": {
    "3000": {
      "label": "Front-End Next.js (Dashboard)",
      "onAutoForward": "openBrowser"
    },
    "8000": { "label": "API FastAPI" },
    "8001": { "label": "AI Engine FastAPI" }
  }
}
